# MongoDB 連線字串 (預設 Port: 27017)
MONGODB_URI=mongodb://user:password@localhost:27017/videohub?authSource=videohub

# 平台自訂品牌名稱 (預設: VideoHub，可於 .env.local 自行設定)
NEXT_PUBLIC_APP_NAME=VideoHub

# 聯絡客服信箱 (於隱私權、服務條款及說明頁顯示)
NEXT_PUBLIC_CONTACT_EMAIL=contact@your-domain.com

# Auth.js / NextAuth.js 設定
AUTH_SECRET=<YOUR_RANDOM_SECRET_HEX_OR_BASE64>
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://your-domain.com

# Google OAuth 2.0 Client (在 Google Cloud Console 申請)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# YouTube Data API v3 Key
YOUTUBE_API_KEY=AIzaSy...

# 管理員 Email 清單 (以逗號分隔，符合者自動具備 Admin 權限與全局觀看權限)
ADMIN_EMAILS=your_email@gmail.com

# 郵件通知 - 主用 Gmail SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=VideoHub <noreply@your-domain.com>

# 郵件通知 - 備用 Resend (Gmail SMTP 失敗時自動 Fallback)
RESEND_API_KEY=re_...

# 系統排程同步密鑰 (Cron Job Bearer Token)
CRON_SECRET=your_cron_secret_token

# 服務監聽 Port (預設 3000)
PORT=3000
NODE_ENV=production
