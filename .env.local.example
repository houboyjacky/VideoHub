# ==============================================================================
# 🟢 第一級：核心必填 (Core Required - 基礎運行只需此區塊)
# ==============================================================================

# 1. Auth.js / NextAuth 加密金鑰 (可使用 openssl rand -base64 32 生成)
AUTH_SECRET=your_generated_random_secret_hex_or_base64
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# 2. Google OAuth 2.0 Client (在 Google Cloud Console 申請，設定重新導向 URI)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# 3. 管理員 Email 清單 (以逗號分隔，符合者自動具備 Admin 權限與全局觀看權限)
ADMIN_EMAILS=your_admin_email@gmail.com

# 4. MongoDB 資料庫連線字串
#    - 若使用 Docker 內建 MongoDB，此欄位可留空或預設為 mongodb://mongo:27017/videohub
#    - 若自備本地或 MongoDB Atlas 雲端資料庫，請填入完整連線字串
MONGODB_URI=mongodb://localhost:27017/videohub

# ==============================================================================
# 🎨 第二級：外觀與品牌自訂 (Branding & Customization - 選填，具備智慧預設值)
# ==============================================================================

# 平台自訂品牌名稱 (預設: VideoHub，亦可登入後台動態修改)
NEXT_PUBLIC_APP_NAME=VideoHub

# 平台管理員預設顯示稱呼 (預設: 管理員，亦可由資料庫動態抓取或於後台修改)
NEXT_PUBLIC_ADMIN_NAME=管理員

# 聯絡客服信箱 (於隱私權、服務條款及說明頁顯示)
NEXT_PUBLIC_CONTACT_EMAIL=contact@your-domain.com

# 服務監聽 Port (預設 3000)
PORT=3000
NODE_ENV=production

# ==============================================================================
# 🚀 第三級：進階外掛服務 (Optional Integrations - 依需求啟用，亦可於後台網頁設定)
# ==============================================================================

# YouTube Data API v3 Key (若未填寫，可手動新增影片或登入後台設定)
YOUTUBE_API_KEY=

# 郵件通知 - 主用 Gmail SMTP (Nodemailer) (若未填寫則僅在系統內部記錄，不發信)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=VideoHub <noreply@your-domain.com>

# 郵件通知 - 備用 Resend (Gmail SMTP 失敗時自動 Fallback)
RESEND_API_KEY=

# 系統排程同步密鑰 (Cron Job Bearer Token)
CRON_SECRET=your_cron_secret_token

# 伺服器與活動日誌設定 (選填)
LOG_LEVEL=info
LOG_DIR=./logs
ACTIVITY_LOG_PAGE_SIZE=50
ACTIVITY_LOG_SEARCH_LIMIT=500
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_MINUTES=15

