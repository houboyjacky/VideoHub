generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Video {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  ytId            String    @unique
  title           String
  description     String?
  thumbnail       String
  ytPrivacyStatus String    @default("unlisted") // public | unlisted | private
  publishedAt     DateTime
  shootingDate    DateTime?
  groupIds        String[]  @db.ObjectId
  tags            String[]  @default([])
  deleted         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("videos")
}

model Group {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("groups")
}

model User {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  email      String    @unique
  name       String
  image      String?
  status     String    @default("pending") // pending | approved | rejected
  groupIds   String[]  @default([]) @db.ObjectId
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("users")
}

model InviteCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  expiresAt DateTime
  disabled  Boolean  @default(false)
  usedBy    String[] @default([]) // 紀錄使用此碼之 Email 清單
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invite_codes")
}

model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  email     String
  name      String?
  image     String?
  action    String   // login | logout | register | approve | reject
  status    String   @default("success") // success | failed
  os        String?  // Windows 11, macOS, iOS, Android, Linux
  browser   String?  // Chrome, Safari, Firefox, Edge
  ip        String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

